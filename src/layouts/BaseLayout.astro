---
import Header from '../components/Header.astro';
import PageWave from '../components/PageWave.astro';
import MobileActions from '../components/MobileActions.astro';
import Footer from '../components/Footer.astro';
import HomeIntro from '../components/HomeIntro.astro';
import ChickenPopup from '../components/ChickenPopup.astro';
import { asset, locale, metadata, structuredData, t, url, type Language, type PageKind } from '../lib/site';
import '../styles/global.css';
import '../styles/redesign.css';
import '../styles/chinese-font.css';
import '../styles/reading.css';
import '../styles/geometry.css';
import '../styles/menu.css';
import '../styles/customer.css';
import '../styles/home-poster.css';
import '../styles/brand-type.css';
import '../styles/round-two.css';
import '../styles/menu-crav.css';
import '../styles/home-type-scale.css';
import '../styles/white-type-outline.css';
import '../styles/body-type.css';
import '../styles/home-refinements.css';
import '../styles/wave-motion.css';
import '../styles/footer.css';
import '../styles/fyno-audit.css';
const {lang,kind} = Astro.props as {lang:Language,kind:PageKind};
const meta=metadata(lang,kind);
// Franchise copy belongs to the brand HQ site; legal pages are HQ copies. This domain ranks for the Brooklyn store.
const canonical=(kind==='partner'?'https://frydomexpress.com':'https://frydomexpressny.com')+url(lang,kind);
const noindex=kind==='privacy'||kind==='terms';
const hero=kind==='home'?locale(lang).menu.find((item:any)=>item.id==='angus-beef-cheeseburger').image:asset('/images/brand-new-1280-1280.webp');
const shareImage=locale(lang).offers?.find((offer:any)=>offer.id===kind)?.image||hero;
---
<!DOCTYPE html>
<html lang={lang==='en'?'en':'zh-Hans'}>
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#f9ecd2"/>
    <title>{meta.title}</title>
    <meta name="description" content={meta.description}/>
    <link rel="canonical" href={canonical}/>
    {noindex&&<meta name="robots" content="noindex, follow"/>}
    <link rel="alternate" hreflang="en" href={'https://frydomexpressny.com'+url('en',kind)}/>
    <link rel="alternate" hreflang="zh-Hans" href={'https://frydomexpressny.com'+url('zh',kind)}/>
    <link rel="alternate" hreflang="x-default" href={'https://frydomexpressny.com'+url('en',kind)}/>
    <link rel="icon" href={asset('/favicon-32.png').src} type="image/png"/>
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png').src}/>
    <link rel="stylesheet" href="/assets/fonts/fonts.css"/>
    {kind==='home'&&<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/crav/MouseMemoirs-latin.woff2" crossorigin/>}
    {kind==='home'&&<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/crav/Modak-latin.woff2" crossorigin/>}
    {kind==='home'&&<link rel="preload" as="image" href={hero.src}/>}
    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Frydom Express"/>
    <meta property="og:title" content={meta.title}/>
    <meta property="og:description" content={meta.description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={'https://frydomexpressny.com'+shareImage.src}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData(lang,kind)).replaceAll('<','\u003c')}/>
    <!-- GA4 (001 Frydom, property 555559062). Only counts on the live domain. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XEQBJV83KY"></script>
    <script is:inline>
      if(/^(www\.)?frydomexpressny\.com$/.test(location.hostname)){
        window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;
        gtag('js',new Date());gtag('config','G-XEQBJV83KY');
        document.addEventListener('click',function(e){
          var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;var h=a.href,n=null;
          if(/^tel:/.test(h))n='call_click';else if(/chowbus\.com/.test(h))n='order_click';else if(/ubereats\.com|doordash\.com|grubhub\.com/.test(h))n='delivery_click';else if(/google\.[a-z.]+\/maps|maps\.app\.goo\.gl|maps\.apple\.com/.test(h))n='directions_click';
          if(!n)return;var w=a.closest('header,footer,dialog,[role=dialog],section,main');
          gtag('event',n,{click_location:w?(w.id||w.className.split(' ')[0]||w.tagName.toLowerCase()):'page',link_url:h,transport_type:'beacon'});
        },true);
      }
    </script>
  </head>
  <body id="top" class:list={[`page-${kind}`,`locale-${lang}`]}>
    <PageWave/>
    {kind==='home'&&<HomeIntro lang={lang}/>}
    <a href="#main" class="skip-link">{t(lang,'Skip to content','跳转到正文')}</a>
    <Header lang={lang} kind={kind}/>
    <main id="main"><slot/></main>
    <Footer lang={lang}/>
    <MobileActions lang={lang}/>
    {kind==='home'&&<ChickenPopup lang={lang}/>}
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
