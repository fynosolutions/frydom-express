---
import OrderPicker from './OrderPicker.astro';
import {locale,t,type Language} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const store=locale(lang).locations[0];
---
<div class="store-actions">
  <a class="button button-outline" href={store.mapUrl} target="_blank" rel="noopener noreferrer">{t(lang,'Get directions','门店导航')} ↗</a>
  <a class="button button-outline" href={store.phoneHref}>{t(lang,'Call','致电')} {store.phone}</a>
  <OrderPicker lang={lang}/>
</div>
