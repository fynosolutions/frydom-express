---
import OfferCards from './OfferCards.astro';
import Arrow from './Arrow.astro';
import MenuCard from './MenuCard.astro';
import OrderPicker from './OrderPicker.astro';
import StoreActions from './StoreActions.astro';
import{locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const content=locale(lang);
const hero=content.menu.find((item:any)=>item.id==='angus-beef-cheeseburger-combo').image;
const favorites=['original-recipe-fried-chicken','crispy-chicken-burger-combo','snow-cheese-wings'].map(id=>content.menu.find((item:any)=>item.id===id));
---
<section class="hero wrap" id="brand" aria-labelledby="hero-title">
  <div class="hero-copy">
    <span class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> FRYDOM EXPRESS · {t(lang,'FRIED CHICKEN & BURGERS','炸鸡与汉堡')}</span>
    <h1 id="hero-title">{lang==='en'?<><span>Crispy.</span> <span>Juicy.</span> <span class="outline-word">Made fresh.</span></>:<><span>金黄酥脆</span><span class="outline-word">一口爆汁<span class="title-dot">。</span></span></>}</h1>
    <p class="hero-intro">{content.home.intro}</p>
    <p class="hero-address">781 61st St · Brooklyn, NY · {content.locations[0].hoursText}</p>
    <div class="hero-actions"><a class="button button-outline" href={url(lang,'menu')}>{t(lang,'View menu','查看菜单')} <Arrow/></a><OrderPicker lang={lang}/></div>
    </div>
  <div class="hero-visual"><img class="hero-food" src={hero.src} width={hero.width} height={hero.height} alt={t(lang,'Angus Beef Cheeseburger Combo — burger, fries and a soft drink','安格斯芝士牛肉堡套餐：汉堡、薯条与汽水')} fetchpriority="high" decoding="async"/></div>
</section>

<section class="favorites section-pad wrap" id="favorites" aria-labelledby="favorites-title">
  <div class="section-heading"><div><span class="eyebrow">{t(lang,'THE CROWD PLEASERS','这几款，先吃为敬')}</span><h2 id="favorites-title"><span class="title-highlight">{t(lang,'Meet your','来认识你的')}<br/><em>{t(lang,'new favorites.','心头好。')}</em></span></h2></div><div><p>{t(lang,'A golden crunch, a juicy bite, and plenty of reasons to come back. Ask in store about current favorites and new arrivals.','金黄酥脆，鲜嫩多汁。经典好滋味，每次都有回来的理由。到店时欢迎咨询当日热卖与新品。')}</p><a class="text-link" href={url(lang,'menu')}>{t(lang,'View the full menu','查看完整菜单')} <Arrow diagonal/></a></div></div>
  <div class="favorites-grid" id="favorites-gallery" aria-label={t(lang,'Customer favorite dishes','人气菜品')}>{favorites.map((item:any,index:number)=><MenuCard item={item} lang={lang} featured index={index}/>)}</div>
  <div class="favorite-controls" hidden><button type="button" data-favorites-prev aria-controls="favorites-gallery" aria-label={t(lang,'Previous favorite dish','上一道人气菜品')}>←</button><button type="button" data-favorites-next aria-controls="favorites-gallery" aria-label={t(lang,'Next favorite dish','下一道人气菜品')}>→</button></div>
  <p class="menu-disclaimer">{t(lang,'Explore all singles and combos on our full menu.','查看完整菜单，了解更多单点与套餐。')}</p>
</section>

<nav class="home-menu-links wrap" aria-label={t(lang,'Browse menu categories','浏览菜单分类')}>{content.categories.map((category:any)=><a href={url(lang,'menu')+'#'+category.id}>{category.name} ↗</a>)}</nav>

<OfferCards lang={lang} home/>

<section class="home-visit wrap section-pad" id="our-locations" aria-labelledby="locations-title">
  <img src={content.locations[0].image.src} width={content.locations[0].image.width} height={content.locations[0].image.height} alt={t(lang,'Frydom Express Brooklyn storefront','Frydom Express Brooklyn 门店')} loading="lazy"/>
  <div><span class="eyebrow">BROOKLYN, NEW YORK</span><h2 id="locations-title">{t(lang,'Come hungry.','带着好胃口来。')}</h2>
    <p>781 61st St, Brooklyn, NY 11220</p><p>{t(lang,'Hours','营业时段')} · {content.locations[0].hoursText}</p>
    <p class="visit-note">{t(lang,'Dine-in · Takeout. Call before visiting to confirm the day’s hours.','堂食 · 外带。到店前请致电确认当日营业安排。')}</p>
    <StoreActions lang={lang}/><a class="text-link" href={url(lang,'locations')}>{t(lang,'Location details','查看门店详情')} ↗</a>
  </div>
</section>
<section class="home-partner-brief wrap"><div><h2>{t(lang,'Grow with Frydom.','与 Frydom 一起成长。')}</h2><p>{t(lang,'Explore opening support and partnership opportunities.','了解开业支持与加盟合作机会。')}</p></div><a class="text-link" href={url(lang,'partner')}>{t(lang,'Become a partner','了解加盟合作')} ↗</a></section>
