---
import VideoGallery from './VideoGallery.astro';
import Arrow from './Arrow.astro';

import OrderPicker from './OrderPicker.astro';
import StoreActions from './StoreActions.astro';
import FoodCloseups from './FoodCloseups.astro';
import{locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const content=locale(lang);
---
<section class="food-poster" id="brand" aria-labelledby="hero-title">
  <div class="poster-stage">
    <div class="poster-wordmark" aria-hidden="true">FRYDOM</div>
    <span class="food-sticker sticker-crispy" aria-hidden="true">{t(lang,'GOLDEN','金黄')}<br/>{t(lang,'& CRISPY','酥脆')}</span>
    <img class="hero-food" src="/assets/offers/mascot-run-cup.webp" width="720" height="786" alt={t(lang,'The Frydom chicken mascot hopping across the letters','Frydom 小鸡在字母上跳来跳去')} fetchpriority="high" decoding="async"/>
    <span class="food-sticker sticker-juicy" aria-hidden="true">{t(lang,'ONE BIG','一口')}<br/>{t(lang,'JUICY BITE.','爆汁！')}</span>
  </div>
  <div class="poster-bottom wrap">
    <div class="poster-copy">
      <h1 id="hero-title">{lang==='en'?<><span class="hero-title-line">Big crunch.</span>{' '}<span class="hero-title-line">Bigger cravings.</span></>:'金黄酥脆，一口爆汁。'}</h1>
      <p>{t(lang,'Chinese-style and Korean-style fried chicken, burgers and Taning lemon tea. Fried fresh in Sunset Park.','中式与韩式炸鸡、汉堡，配一杯挞柠柠檬茶。日落公园现点现炸。')}</p>
      <div class="hero-actions"><OrderPicker lang={lang}/><a class="button button-outline" href={url(lang,'menu')}>{t(lang,'Explore the menu','查看菜单')} <Arrow/></a></div>
      <div class="poster-location">
        <span>BROOKLYN, NEW YORK</span>
        <p>781 61st St · <span class="poster-hours">{content.locations[0].hoursText}</span></p>
      </div>
    </div>
  </div>
</section>

<a class="offer-strip" href={url(lang,'leg-quarter')}><span class="offer-strip-tag">{t(lang,'NEW','新品')}</span><strong>{t(lang,'Crispy-Skinned Chicken Leg Quarter','脆皮手枪腿')} · $6.45</strong><span class="offer-strip-more">{t(lang,'See all offers','查看全部优惠')} <Arrow/></span></a>

<FoodCloseups lang={lang}/>

<VideoGallery lang={lang}/>

<section class="home-visit wrap section-pad" id="our-locations" aria-labelledby="locations-title">
  <img src={content.locations[0].detailImage.src} width={content.locations[0].detailImage.width} height={content.locations[0].detailImage.height} alt={t(lang,'Inside Frydom Express Brooklyn: order counter and menu boards','Frydom Express Brooklyn 店内：点餐台与菜单屏')} loading="lazy"/>
  <div><h2 id="locations-title">{t(lang,'Brooklyn.','布鲁克林，')}<br/>{t(lang,'Come hungry.','带着好胃口来。')}</h2>
    <p>781 61st St, Brooklyn, NY 11220</p><p>{t(lang,'Hours','营业时段')} · {content.locations[0].hoursText}</p>
    <p class="visit-note">{t(lang,'Dine-in · Takeout · Delivery. Near 8th Ave in Sunset Park.','堂食 · 外带 · 外卖。日落公园，近 8 大道。')}</p>
    <StoreActions lang={lang}/><a class="text-link" href={url(lang,'locations')}>{t(lang,'Location details','查看门店详情')} ↗</a>
  </div>
</section>


<script>
  /* Hero mascot hops along the tops of the FRYDOM letters: F → R → Y → D → O → M, then one long hop back to F.
     It starts only after the site's own entry (letters pop in, chicken grows in) has finished, so that motion is untouched.
     Reduced motion: the mascot simply sits on top of the F. Paused while the hero is off screen. */
  const stage = document.querySelector<HTMLElement>('.poster-stage');
  const word = stage?.querySelector<HTMLElement>('.poster-wordmark');
  const food = stage?.querySelector<HTMLImageElement>('.hero-food');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let hop: Animation | undefined;
  let visible = true;

  type Spot = {x: number; y: number};
  function measure(): {spots: Spot[]; w: number; h: number} | null {
    if (!stage || !word || !food || !food.naturalWidth) return null;
    const cs = getComputedStyle(word);
    const ctx = document.createElement('canvas').getContext('2d');
    if (!ctx) return null;
    ctx.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const stroke = parseFloat(cs.webkitTextStrokeWidth || '0') || 0;
    const box = stage.getBoundingClientRect();
    const letters: {cx: number; top: number; w: number}[] = [];
    const walker = document.createTreeWalker(word, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      for (let i = 0; i < node.data.length; i++) {
        const ch = node.data[i];
        if (!/\S/.test(ch)) continue;
        const range = document.createRange(); range.setStart(node, i); range.setEnd(node, i + 1);
        const r = range.getBoundingClientRect();
        const m = ctx.measureText(ch);
        const glyphTop = r.top + (m.fontBoundingBoxAscent - m.actualBoundingBoxAscent) - stroke / 2;
        letters.push({cx: r.left + r.width / 2 - box.left, top: glyphTop - box.top, w: r.width});
      }
    }
    if (letters.length < 2) return null;
    const avg = letters.reduce((s, l) => s + l.w, 0) / letters.length;
    const w = Math.round(avg * (innerWidth > 700 ? 0.72 : 0.95));
    const h = Math.round(w * food.naturalHeight / food.naturalWidth);
    /* Sit the chicken on the letter: its bottom overlaps the letter top by a hair, never the letter body. */
    const spots = letters.map(l => ({x: Math.round(l.cx - w / 2), y: Math.round(l.top - h * 0.97)}));
    return {spots, w, h};
  }

  function place() {
    if (!stage || !food) return null;
    const g = measure();
    if (!g) return null;
    /* Make room above the letters for the chicken plus its jump, so it never leaves the poster. */
    const arc = g.h * 0.42;
    const back = 1.35;
    const topMost = Math.min(...g.spots.map(s => s.y));
    stage.style.marginTop = '';
    const need = Math.max(0, Math.ceil(arc * back + 4 - topMost));
    if (need) { stage.style.marginTop = need + 'px'; }
    food.style.width = g.w + 'px';
    food.style.height = g.h + 'px';
    food.style.left = '0px';
    food.style.top = '0px';
    food.style.translate = `${g.spots[0].x}px ${g.spots[0].y}px`;
    food.dataset.hop = 'placed';
    return {...g, arc, back};
  }

  function run() {
    hop?.cancel(); hop = undefined;
    const g = place();
    if (!g || !food || reduce.matches || !Element.prototype.animate) return;
    if (food.dataset.heroFoodMotion && food.dataset.heroFoodMotion !== 'revealed') return;
    const frames: Keyframe[] = [];
    const legs: {from: Spot; to: Spot; dur: number; arc: number; dir?: number}[] = [];
    for (let i = 0; i < g.spots.length - 1; i++) legs.push({from: g.spots[i], to: g.spots[i + 1], dur: 460, arc: g.arc});
    legs.push({from: g.spots[g.spots.length - 1], to: g.spots[0], dur: 1000, arc: g.arc * g.back, dir: -1});
    const rest = 520, takeoff = 110, land = 150;
    const total = legs.reduce((s, l) => s + rest + takeoff + l.dur + land + (l.dir ? 160 : 0), 0);
    let t = 0;
    const at = (ms: number, k: Keyframe) => frames.push({...k, offset: Math.min(1, ms / total)});
    const pos = (p: Spot) => `${p.x}px ${p.y}px`;
    for (const leg of legs) {
      const d = leg.dir ?? 1;
      const sc = (x: number, y: number) => `${(x * d).toFixed(3)} ${y.toFixed(3)}`;
      at(t, {translate: pos(leg.from), scale: '1 1'});
      t += rest; at(t, {translate: pos(leg.from), scale: d < 0 ? '-1 1' : '1 1'});
      t += takeoff; at(t, {translate: `${leg.from.x}px ${leg.from.y + g.h * 0.04}px`, scale: sc(1.07, .9)});
      const n = 14;
      for (let i = 1; i <= n; i++) {
        const u = i / n, e = u < .5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
        const x = leg.from.x + (leg.to.x - leg.from.x) * e;
        const y = leg.from.y + (leg.to.y - leg.from.y) * u - leg.arc * 4 * u * (1 - u);
        const s = i === n ? sc(1.1, .86) : sc(1 - .05 * Math.sin(Math.PI * u), 1 + .07 * Math.sin(Math.PI * u));
        at(t + leg.dur * u, {translate: `${x.toFixed(1)}px ${y.toFixed(1)}px`, scale: s});
      }
      t += leg.dur;
      t += land; at(t, {translate: pos(leg.to), scale: d < 0 ? '-1 1' : '1 1'});
      if (d < 0) { t += 160; at(t, {translate: pos(leg.to), scale: '1 1'}); }
    }
    frames[frames.length - 1].offset = 1;
    try {
      hop = food.animate(frames, {duration: total, iterations: Infinity, easing: 'linear'});
      food.dataset.hop = 'on';
      if (!visible) hop.pause();
    } catch { /* stays seated on the F */ }
  }

  if (stage && word && food) {
    const start = () => (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => requestAnimationFrame(run));
    if (food.complete) start(); else food.addEventListener('load', start, {once: true});
    /* Wait for the site's own grow-in to finish before hopping. */
    new MutationObserver(() => { if (food.dataset.heroFoodMotion === 'revealed' && food.dataset.hop !== 'on') run(); })
      .observe(food, {attributes: true, attributeFilter: ['data-hero-food-motion']});
    let resizeTimer: number | undefined;
    addEventListener('resize', () => { clearTimeout(resizeTimer); resizeTimer = window.setTimeout(run, 180); });
    reduce.addEventListener('change', run);
    if ('IntersectionObserver' in window) new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      if (hop) visible ? hop.play() : hop.pause();
    }).observe(stage);
  }
</script>
