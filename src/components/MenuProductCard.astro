---
import Price from './Price.astro';
import BreakableText from './BreakableText.astro';
import {t,url,type Language} from '../lib/site';
const {item,lang}=Astro.props as {item:any,lang:Language};
const singlePrice=item.variants.filter((variant:any)=>variant.status!=='conflict').length===1;
---
<article class:list={['menu-item','menu-product',{'single-price':singlePrice}]} id={item.id} data-item-id={item.id}>
  <div class="item-photo"><img src={item.image.src} alt={'Frydom Express '+item.name} width={item.image.width} height={item.image.height} loading="lazy" decoding="async"/>{item.imageStatus==='update_pending'&&<span class="photo-note">{t(lang,'Photo update coming soon','图片更新中')}</span>}</div>
  <div class="item-body">
    <div class="product-meta"><h3><BreakableText text={item.name}/></h3><Price item={item} lang={lang}/></div>
    <details class="product-details">
      <summary aria-label={t(lang,'Details for '+item.name,'查看'+item.name+'详情')}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5v14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></summary>
      <div class="product-detail-copy">
        <p class="item-description">{item.description}</p>
        {item.offerKind&&<a class="text-link" href={url(lang,item.offerKind)}>{t(lang,'View offer details','查看活动详情')} ↗</a>}
        {item.labels.filter((label:string)=>!/Photo update|图片更新/.test(label)).map((label:string)=><p class="item-note">{label}</p>)}
        {item.notes.map((note:string)=><p class="item-note">{note}</p>)}
      </div>
    </details>
  </div>
</article>
