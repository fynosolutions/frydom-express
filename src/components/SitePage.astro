---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from './Breadcrumb.astro';
import Home from './Home.astro';
import Menu from './Menu.astro';
import Story from './Story.astro';
import Locations from './Locations.astro';
import Partner from './Partner.astro';
import Support from './Support.astro';
import Legal from './Legal.astro';
import{type Language,type PageKind}from'../lib/site';
const{lang,kind}=Astro.props as {lang:Language,kind:PageKind};
---
<BaseLayout lang={lang} kind={kind}>
  {kind!=='home'&&<Breadcrumb lang={lang} kind={kind}/>}
  {kind==='home'&&<Home lang={lang}/>}
  {kind==='menu'&&<Menu lang={lang}/>}
  {kind==='story'&&<Story lang={lang}/>}
  {kind==='locations'&&<Locations lang={lang}/>}
  {kind==='partner'&&<Partner lang={lang}/>}
  {kind==='support'&&<Support lang={lang}/>}
  {(kind==='privacy'||kind==='terms')&&<Legal lang={lang} kind={kind}/>}
</BaseLayout>
