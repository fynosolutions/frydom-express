---
import {locale,t,url,type Language,type PageKind} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const offers: {id: PageKind; title: string; headline: string; description: string}[] = locale(lang).offers;
---
<section class="poster-list wrap" aria-labelledby="offers-title">
  <h1 id="offers-title">{t(lang,'Offers','新品与优惠')}</h1>
  {offers.map(offer => (
    <a class="offer-poster" href={url(lang,offer.id)}>
      <img src={`/assets/posters/${offer.id}-1.webp`} width={offer.id==='staff-offer'?1855:1701}
        height="2400" alt="" decoding="async"/>
      <span class="offer-card-copy"><strong>{offer.title}</strong><em>{offer.headline}</em><span>{offer.description}</span><span class="offer-card-link">{t(lang,'See details','查看详情')} →</span></span>
    </a>
  ))}
</section>
<style>
  .poster-list {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    align-items: start;
    gap: clamp(16px,2vw,32px);
    padding-block: clamp(24px,4vw,56px);
  }
  #offers-title { grid-column: 1 / -1; margin: 0 0 8px; }
  .offer-poster { display: flex; flex-direction: column; gap: 16px; text-decoration: none; color: inherit; }
  .offer-poster img { aspect-ratio: 1855 / 2400; background: var(--geo-paper); border-radius: 14px; }
  .offer-card-copy { display: grid; gap: 6px; font: 500 17px/1.5 var(--sans); }
  .offer-card-copy strong { font: 400 30px/1.1 var(--display); color: var(--accent-strong); }
  .offer-card-copy em { font-style: normal; font-weight: 700; font-size: 19px; }
  .offer-card-link { display: inline-flex; gap: 8px; align-items: center; font-weight: 700; color: var(--accent-strong); margin-top: 4px; }
  .offer-poster img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .offer-poster:focus-visible { outline: 3px solid var(--accent-strong); outline-offset: 4px; }
  @media(max-width:700px) { .poster-list { grid-template-columns: 1fr; } }
</style>
