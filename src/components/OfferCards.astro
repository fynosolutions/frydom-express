---
import {locale,t,url,type Language,type PageKind} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const offers: {id: PageKind; title: string}[] = locale(lang).offers;
---
<section class="poster-list wrap" aria-labelledby="offers-title">
  <h1 id="offers-title">{t(lang,'Offers','新品与优惠')}</h1>
  {offers.map(offer => (
    <a class="offer-poster" href={url(lang,offer.id)}>
      <img src={`/assets/posters/${offer.id}-1.webp`} width={offer.id==='staff-offer'?1855:1701}
        height="2400" alt={offer.title} decoding="async"/>
    </a>
  ))}
</section>
<style>
  .poster-list {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    align-items: start;
    gap: clamp(16px,2vw,32px);
    padding-block: clamp(24px,4vw,56px);
  }
  #offers-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .offer-poster {
    display: block;
    aspect-ratio: 1855 / 2400;
    background: var(--geo-paper);
  }
  .offer-poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .offer-poster:focus-visible { outline: 3px solid var(--accent-strong); outline-offset: 4px; }
  @media(max-width:700px) { .poster-list { grid-template-columns: 1fr; } }
</style>
