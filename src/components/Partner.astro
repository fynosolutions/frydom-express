---
import FranchiseForm from './FranchiseForm.astro';
import Arrow from './Arrow.astro';
import Support from './Support.astro';
import{asset,locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const content=locale(lang).partner;
const photo=asset('/images/store-outside-800.webp');
---
<section class="editorial-hero partner-hero wrap" id="content"><div><span class="eyebrow">{t(lang,'BECOME A FRYDOM EXPRESS PARTNER','成为 Frydom Express 合作伙伴')}</span><h1><span class="title-highlight">{t(lang,'Big flavor.','大有滋味。')}<br/><em>{t(lang,'Shared ambition.','一起创造。')}</em></span></h1><p class="lead">{content.intro}</p><a class="button button-dark" href="#franchise-inquiry">{t(lang,'Let’s talk partnership','聊聊加盟合作')}<Arrow diagonal/></a></div><div class="editorial-photo"><img src={photo.src} width={photo.width} height={photo.height} alt={t(lang,'Frydom Express Brooklyn storefront','Frydom Express 纽约布鲁克林门店外观')} fetchpriority="high"/><span class="photo-caption">{t(lang,'A BRAND BUILT FOR THE NEIGHBORHOOD','把好味道带进更多社区')}</span></div></section>
<div class="partner-tags wrap">{content.tags.map((tag:string)=><span>✳ {tag}</span>)}</div><p class="partner-terms wrap">{content.note}</p>
<nav class="partner-index wrap" aria-label={t(lang,'Partnership sections','加盟内容导航')}><a href="#why-partner">{t(lang,'Why partner','合作优势')}</a><a href="#who-we-want">{t(lang,'Who we’re looking for','合作伙伴')}</a><a href="#partnership-process">{t(lang,'The process','沟通流程')}</a><a href="#partner-support">{t(lang,'Partner support','总部支持')}</a><a href="#franchise-inquiry">{t(lang,'Make an inquiry','提交意向')}</a></nav>
<div class="partner-source wrap" set:html={content.bodyHtml}/>
<Support lang={lang}/>
<FranchiseForm lang={lang}/>
