---
import Arrow from './Arrow.astro';
import StoreActions from './StoreActions.astro';
import{locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const locations=locale(lang).locations.map((location:any)=>({...location,image:location.detailImage||location.image}));
---
<section class="page-intro wrap" id="locations"><span class="eyebrow">{t(lang,'FIND YOUR FRYDOM','找到你的 Frydom')}</span><h1><span class="title-highlight">{t(lang,'Come hungry.','带着好胃口。')}<br/><em>{t(lang,'Leave happy.','满载好心情。')}</em></span></h1><div class="intro-bottom"><p>{t(lang,'Good food and a welcoming place to enjoy it. Visit our Frydom Express location in Brooklyn, New York.','好好吃一餐，享受社区里的快乐味道。欢迎到访 Frydom Express 纽约布鲁克林门店。')}</p><nav class="location-index" aria-label={t(lang,'Choose a location','选择门店')}>{locations.map((location:any)=><a href={'#'+location.id}>{location.address.addressLocality}<Arrow diagonal/></a>)}</nav></div></section>
<div class="wrap locations-list" id="content">{locations.map((location:any,index:number)=><article class="location-detail" id={location.id} aria-labelledby={location.id+'-title'}><div class="location-detail-photo"><img src={location.image.src} width={location.image.width} height={location.image.height} alt={t(lang,`Frydom Express ${location.name} ${location.detailImage?'store interior':'storefront'}`,`Frydom Express ${location.name} ${location.detailImage?'门店内景':'门店外观'}`)} loading={index===0?'eager':'lazy'} decoding="async"/><span class="location-service">{t(lang,'DINE IN · TAKEOUT','堂食 · 外带')}</span></div><div class="location-detail-copy"><span class="eyebrow">0{index+1} / NEW YORK</span><h2 id={location.id+'-title'}><span class="title-highlight">Frydom Express<br/><em>{location.address.addressLocality}.</em></span></h2><dl><div><dt>{t(lang,'ADDRESS','门店地址')}</dt><dd><address>{location.address.streetAddress}<br/>{location.address.addressLocality}, {location.address.addressRegion} {location.address.postalCode}<br/>United States</address></dd></div><div><dt>{t(lang,'HOURS','营业时段')}</dt><dd>{location.hoursText}<small>{t(lang,'Call before visiting to confirm the day’s hours.','到店前请致电确认当日营业安排。')}</small></dd></div><div><dt>{t(lang,'SERVICES','门店服务')}</dt><dd>{t(lang,location.services.join(' · '),'堂食 · 外带')}</dd></div></dl><StoreActions lang={lang}/><a class="text-link" href={url(lang,'menu')}>{t(lang,'Take a look at the menu','先看看菜单')}<Arrow/></a></div></article>)}</div>
<style is:global>
  #main .location-detail-photo { align-self: start; aspect-ratio: auto; }
  #main .location-detail-photo > img { width: 100%; height: auto; aspect-ratio: auto; object-fit: contain; }
</style>
