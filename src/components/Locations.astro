---
import Arrow from './Arrow.astro';
import PartnerBanner from './PartnerBanner.astro';
import{locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const locations=locale(lang).locations;
---
<section class="page-intro wrap" id="locations"><span class="eyebrow">{t(lang,'FIND YOUR FRYDOM','找到你的 Frydom')}</span><h1>{t(lang,'Come hungry.','带着好胃口。')}<br/><em>{t(lang,'Leave happy.','满载好心情。')}</em></h1><div class="intro-bottom"><p>{t(lang,'Good food and a welcoming place to enjoy it. These are the Frydom Express locations currently listed on our website.','好好吃一餐，享受社区里的快乐味道。以下为网站目前列示的 Frydom Express 门店。')}</p><nav class="location-index" aria-label={t(lang,'Choose a location','选择门店')}>{locations.map((location:any)=><a href={'#'+location.id}>{location.address.addressLocality}<Arrow diagonal/></a>)}</nav></div></section>
<div class="wrap locations-list" id="content">{locations.map((location:any,index:number)=><article class="location-detail" id={location.id} aria-labelledby={location.id+'-title'}><div class="location-detail-photo"><img src={location.image.src} width={location.image.width} height={location.image.height} alt={t(lang,`Frydom Express ${location.name} ${index===0?'storefront':'store interior'}`,`Frydom Express ${location.name} ${index===0?'门店外观':'门店内景'}`)} loading={index===0?'eager':'lazy'} decoding="async"/><span class="location-service">{t(lang,'DINE IN · TAKEOUT','堂食 · 外带')}</span></div><div class="location-detail-copy"><span class="eyebrow">0{index+1} / {location.address.addressRegion=== 'NY'?'NEW YORK':'MISSOURI'}</span><h2 id={location.id+'-title'}>Frydom Express<br/><em>{location.address.addressLocality}.</em></h2><dl><div><dt>{t(lang,'ADDRESS','门店地址')}</dt><dd><address>{location.address.streetAddress}<br/>{location.address.addressLocality}, {location.address.addressRegion} {location.address.postalCode}<br/>United States</address></dd></div><div><dt>{t(lang,'LISTED HOURS','网站列示营业时间')}</dt><dd>{location.hoursText}<small>{t(lang,'Days of operation are not specified.','营业星期尚未注明。')}</small></dd></div><div><dt>{t(lang,'SERVICES','门店服务')}</dt><dd>{t(lang,location.services.join(' · '),'堂食 · 外带')}</dd></div></dl>{location.id==='brooklyn'&&<aside class="campaign-callout"><h3>{t(lang,'Staff & group meal benefits','员工专享 · 团餐福利')}</h3><p>{t(lang,'Show your work ID. Spend $10 for 10% off; group orders of $50 / $100 also receive the advertised gift.','出示工作证件 ID，消费满 $10 享九折；团餐满 $50 / $100 另享对应赠品。')}</p><a class="text-link" href={url(lang,'staff-offer')}>{t(lang,'View terms','查看完整规则')} ↗</a><a href="tel:+19298050718">929-805-0718</a></aside>}<a class="button button-dark" href={url(lang,'menu')}>{t(lang,'Take a look at the menu','先看看菜单')}<Arrow/></a></div></article>)}</div>
<section class="locations-note wrap"><h2>{t(lang,'A quick heads-up.','来店之前，了解一下。')}</h2><p>{t(lang,'Hours and menu information reflect the original website. The listed hours do not specify weekdays. Please confirm current availability with the restaurant.','以上营业时间与菜单信息来自原网站，营业星期尚未注明。具体供应与现行营业安排请向门店确认。')}</p></section>
<PartnerBanner lang={lang}/>
