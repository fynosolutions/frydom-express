---
import MenuCard from './MenuCard.astro';
import PartnerBanner from './PartnerBanner.astro';
import Arrow from './Arrow.astro';
import BreakableText from './BreakableText.astro';
import{locale,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
const content=locale(lang);
const subtitles=lang==='en'?['Our signature golden crunch. Classic or spicy.','Sauced, seasoned, and ready to share.','Big flavor in every little bite.','Comfort food with a little more character.','Every good meal deserves good company.']:['招牌金黄酥脆，原味与辣味可选。','酱料与调味各有风味，分享更满足。','轻松入口，每一口都够味。','经典汉堡与卷饼，组合你的满足。','好吃的小食，让这一餐更完整。'];
---
<section class="page-intro wrap" id="menu"><span class="eyebrow">{t(lang,'THE FRYDOM EXPRESS MENU','Frydom Express 菜单')}</span><h1>{t(lang,'Follow your','听从你的')}<br/><em><BreakableText text={t(lang,'cravings.','好胃口。')}/></em></h1><div class="intro-bottom"><p>{t(lang,'Golden fried chicken, flavor-packed wings, burgers, wraps and all the good sides. Make it a meal worth slowing down for.','金黄炸鸡、风味鸡翅、汉堡、卷饼与经典小食。好好吃一餐，快乐就这么简单。')}</p><p class="small-note">{t(lang,'This is a representative menu. Selection, availability and pricing may vary by location. Please check with the restaurant for current information.','以下为代表性菜单，菜品、供应与价格可能因门店而异。现行信息请向门店确认。')}</p></div></section>
<div class="wrap campaign-callout"><p>{t(lang,'New arrivals, blind box surprises and staff meal benefits.','新品、盲盒惊喜，还有员工团餐福利。')}</p><a class="text-link" href={url(lang,'offers')}>{t(lang,'Explore offers','查看新品与优惠')} ↗</a><a class="text-link" href={url(lang,'staff-offer')}>{t(lang,'Brooklyn group meals','Brooklyn 团餐优惠')} ↗</a></div>
<nav class="category-nav" aria-label={t(lang,'Menu categories','菜单分类')}><div class="wrap">{content.categories.map((category:any)=><a href={'#'+category.id}>{category.name}</a>)}</div></nav>
<div class="wrap menu-sections" id="content">{content.categories.map((category:any,index:number)=><section class="menu-section" id={category.id} aria-labelledby={category.id+'-title'}><div class="menu-section-heading"><span class="category-index">0{index+1}</span><div><h2 id={category.id+'-title'}>{category.name}</h2><p>{subtitles[index]}</p></div><a href="#menu" class="section-top" aria-label={t(lang,'Back to menu categories','返回菜单分类')}>↑</a></div><div class="menu-grid">{content.menu.filter((item:any)=>item.sectionId===category.id).map((item:any)=><MenuCard item={item} lang={lang}/>)}</div></section>)}</div>
<section class="menu-faq wrap" aria-labelledby="menu-faq-title"><h2 id="menu-faq-title">{t(lang,'A few good things to know.','点餐前，了解一下。')}</h2><details><summary>{t(lang,'Is the menu the same at every location?','每家门店的菜单都一样吗？')}</summary><p>{t(lang,'Menu selection and pricing may vary by location. This page shows representative menu information; please check with the restaurant for current availability and pricing.','产品与价格可能因门店而异。本页为代表性菜单，具体供应及现行价格请咨询门店。')}</p></details><details><summary>{t(lang,'Where can I find a Frydom Express location?','在哪里可以找到 Frydom Express？')}</summary><p>{t(lang,'The website currently lists locations in Brooklyn, New York and Rolla, Missouri.','网站目前列示纽约布鲁克林与密苏里州 Rolla 门店。')} <a href={url(lang,'locations')}>{t(lang,'View addresses and listed hours','查看地址与列示营业时间')} <Arrow diagonal/></a></p></details></section>
<PartnerBanner lang={lang}/>
