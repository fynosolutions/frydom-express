---
import MenuProductCard from './MenuProductCard.astro';

import BreakableText from './BreakableText.astro';
import {data,locale,t,type Language} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const content=locale(lang);
---
<section class="page-intro menu-cover" id="menu">
  <img class="menu-cover-photo" src="/assets/food-closeups/real-chicken-fryer.webp" srcset="/assets/food-closeups/real-chicken-fryer-768.webp 768w, /assets/food-closeups/real-chicken-fryer.webp 1536w" sizes="100vw" width="1536" height="1024" alt={t(lang,'Fried chicken lifted out of the fryer basket','刚出锅的炸鸡')} fetchpriority="high" decoding="async"/>
  <img class="menu-cover-mascot" src="/assets/offers/happy-mascot.webp" width="720" height="900" alt="" aria-hidden="true"/>
  <h1><span class="title-highlight">{t(lang,'Follow your','听从你的')}<br/><em><BreakableText text={t(lang,'cravings.','好胃口。')}/></em></span></h1>
  <svg class="menu-cover-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40Q180 0 360 40T720 40T1080 40T1440 40V80H0Z" fill="currentColor"/></svg>
</section>
<div class="menu-summary wrap">
  <div class="intro-bottom"><p>{t(lang,'Golden fried chicken, signature combos and your favorite flavors. Explore singles, meals, sides and drinks.','金黄炸鸡、特色套餐与人气风味。单点、套餐、小食和饮料，在这里找到你的好滋味。')}</p></div>
  <a class="text-link menu-pdf" href={data.menuPdf} target="_blank" rel="noopener noreferrer">{t(lang,'View the original menu (PDF)','查看原版菜单（PDF）')} <span aria-hidden="true">↗</span></a>
</div>
<div class="campaign-callout menu-offer-wave">
  <svg viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M0 18Q180 -6 360 18T720 18T1080 18T1440 18V142Q1260 166 1080 142T720 142T360 142T0 142Z"/>
  </svg>
  <p>{t(lang,'Discover our latest offers and group meal benefits.','发现近期活动与团餐福利。')}</p>
</div>
<nav class="category-nav" aria-label={t(lang,'Menu categories','菜单分类')}><div class="wrap">{content.categories.map((category:any)=><a href={'#'+category.id}>{category.name}</a>)}</div></nav>
<div class="wrap menu-sections" id="content">
  {content.categories.map((category:any)=><section class="menu-section" id={category.id} aria-labelledby={category.id+'-title'}>
    <div class="menu-section-heading"><div><h2 id={category.id+'-title'}><span class="title-highlight">{category.name}</span></h2><p>{category.description}</p></div><a href="#menu" class="section-top" aria-label={t(lang,'Back to menu categories','返回菜单分类')}>↑</a></div>
    <div class="menu-grid">{content.menu.filter((item:any)=>item.sectionId===category.id).map((item:any)=><MenuProductCard item={item} lang={lang}/>)}</div>
  </section>)}
</div>
<aside class="menu-footnotes wrap" aria-label={t(lang,'Menu notes','菜单备注')}>
  {content.menuFootnotes.map((note:string)=><p>{note}</p>)}
  <p>{t(lang,'For portion sizes and drink add-on conditions,','份量与饮品加购条件，请')} <a href={content.locations[0].phoneHref}>{t(lang,'call the restaurant','致电门店咨询')}</a>{t(lang,'.','。')}</p>
</aside>
