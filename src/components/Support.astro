---
import Arrow from './Arrow.astro';
import {locale,t,type Language} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const content=locale(lang).support;
---
<section class="partner-support section-pad" id="partner-support" aria-labelledby="partner-support-title">
  <div class="section-heading wrap"><h2 id="partner-support-title"><span class="title-highlight">{t(lang,'Partner Support','总部支持')}</span></h2><p>{content.intro}</p></div>
  <nav class="support-overview wrap" aria-label={t(lang,'Support services','支持服务导航')}>{content.overview.map((item:any,index:number)=><a href={'#'+content.sections[index].id}><span class="category-index">0{index+1}</span><h3>{item.title}</h3><p>{item.text}</p><Arrow diagonal/></a>)}</nav>
  <div class="support-details wrap">{content.sections.map((section:any,index:number)=><section class="support-detail" id={section.id} aria-labelledby={section.id+'-title'}><div class="support-detail-image"><img src={section.image.src} width={section.image.width} height={section.image.height} alt={section.title+' — Frydom Express'} loading="lazy" decoding="async"/></div><div><span class="eyebrow">0{index+1} / {t(lang,'PARTNER SUPPORT','总部支持')}</span><h3 id={section.id+'-title'}>{lang==='en'?section.subtitle||section.title:section.title}</h3>{section.paragraphs.map((p:string)=><p>{p}</p>)}<div class="support-tags">{section.tags.map((tag:string)=><span>{tag}</span>)}</div></div></section>)}</div>
</section>
