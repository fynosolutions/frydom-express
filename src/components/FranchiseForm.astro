---
import Arrow from './Arrow.astro';
import{data,t,url,type Language}from'../lib/site';
const{lang}=Astro.props as {lang:Language};
---
<section class="franchise-inquiry wrap section-pad" id="franchise-inquiry" aria-labelledby="inquiry-title"><div class="inquiry-intro"><span class="eyebrow">{t(lang,'LET’S START A CONVERSATION','从一次沟通开始')}</span><h2 id="inquiry-title">{t(lang,'Your city.','你的城市。')}<br/><em>{t(lang,'Our next chapter?','我们的下一站？')}</em></h2><p>{t(lang,'Share your details, the city you have in mind, and any questions. Our team will reach out to explore what a Frydom Express partnership could look like.','留下你的联系方式、意向城市与问题，我们的团队将与你沟通，了解适合你的 Frydom Express 合作方向。')}</p><a class="text-link" href={'mailto:'+data.brand.email}>{data.brand.email}<Arrow diagonal/></a><div class="inquiry-phone"><span>{t(lang,'Partnership line','合作热线')}</span><strong>{data.brand.partnershipPhone}</strong></div></div><form id="franchise-form" class="inquiry-form" method="post" novalidate data-endpoint={data.forms.endpoint} data-language={lang}><div class="form-row"><div class="field"><label for="full-name">{t(lang,'Full name','姓名')} <span aria-hidden="true">*</span></label><input type="text" id="full-name" name="name" autocomplete="name" required aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div><div class="field"><label for="phone-number">{t(lang,'Phone number','联系电话')} <span aria-hidden="true">*</span></label><input type="tel" id="phone-number" name="phone" autocomplete="tel" required aria-describedby="phone-help phone-error"/><span class="field-hint" id="phone-help">{t(lang,'Please include your country code.','请包含国家或地区代码。')}</span><span class="field-error" id="phone-error"></span></div></div><div class="form-row"><div class="field"><label for="wechat">WeChat <small>{t(lang,'(optional)','（选填）')}</small></label><input type="text" id="wechat" name="wechat" autocomplete="off"/></div><div class="field"><label for="email">{t(lang,'Email','电子邮箱')} <small>{t(lang,'(optional)','（选填）')}</small></label><input type="email" id="email" name="email" autocomplete="email" aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div></div><div class="field"><label for="goals">{t(lang,'Your goals or questions','你的意向或问题')} <small>{t(lang,'(optional)','（选填）')}</small></label><textarea id="goals" name="note" rows="4" placeholder={t(lang,'Tell us a little about yourself and your plans.','聊聊你和你的计划。')}></textarea></div><p class="form-privacy">{t(lang,'This form is only used for franchise communication with Frydom Express and will not be shared publicly.','此表单仅用于与 Frydom Express 沟通加盟意向，不会公开展示。')} <a href={url(lang,'privacy')}>{t(lang,'Privacy Policy','隐私政策')}</a></p><button class="button button-dark" type="submit" id="submit-inquiry" disabled><span>{t(lang,'Send inquiry','提交加盟意向')}</span><Arrow diagonal/></button><p class="form-status" id="form-status" aria-live="polite" aria-atomic="true" role="status"></p><noscript><p>{t(lang,'JavaScript is needed to submit this form. Please contact us at','提交此表单需要 JavaScript。你也可以通过以下邮箱联系我们：')} <a href={'mailto:'+data.brand.email}>{data.brand.email}</a>.</p></noscript></form></section>
