---
import Arrow from './Arrow.astro';
import {t,url,type Language} from '../lib/site';
const {lang}=Astro.props as {lang:Language};
const photo='/assets/food-closeups/';
---
<section class="taste-story" aria-labelledby="taste-title">
  <svg class="taste-wave taste-wave-top" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V20C1220 140 1110 0 920 45S650 180 440 100S150 -20 0 45Z" fill="currentColor"/></svg>
  <div class="wrap">
    <div class="taste-lead">
      <div class="taste-copy">
        <h2 id="taste-title">{t(lang,'Hear that','咬下去，')}<br/><em>{t(lang,'crunch?','听见酥脆。')}</em></h2>
        <p>{t(lang,'Golden on the outside. Tender at the heart. This is your kind of comfort food.','外皮金黄酥脆，内里鲜嫩。让人惦记的，就是这一口。')}</p>
        <a class="text-link" href={url(lang,'menu')+'#fried-chicken'}>{t(lang,'Find your chicken fix','挑一份炸鸡')} <Arrow diagonal/></a>
      </div>
    </div>
    <div class="taste-gallery">
      <img class="taste-sticker" src="/assets/offers/happy-mascot.webp" width="720" height="900" alt="" aria-hidden="true" loading="lazy" decoding="async"/>
      <figure class="taste-chicken" data-food-reveal>
        <div class="taste-photo">
        <img src={photo+'crispy-chicken-pull-v1.webp'} srcset={photo+'crispy-chicken-pull-v1-768.webp 768w, '+photo+'crispy-chicken-pull-v1.webp 1536w'} sizes="(max-width: 700px) 92vw, 58vw" width="1536" height="1024" alt={t(lang,'Creative close-up of golden fried chicken pulled apart to reveal the tender center','金黄炸鸡掰开后露出鸡肉纹理的创意近景')} loading="lazy" decoding="async"/>
        </div>
        <figcaption>
          <h3>{t(lang,'Crispy outside.','外酥')}<br/>{' '}{t(lang,'Tender inside.','里嫩')}</h3>
          <div class="taste-caption"><a class="text-link" href={url(lang,'menu')+'#fried-chicken'}>{t(lang,'Meet the fried chicken','看看招牌炸鸡')} <Arrow diagonal/></a></div>
        </figcaption>
      </figure>
      <figure class="taste-detail" data-food-reveal>
        <div class="taste-photo"><img src={photo+'cheeseburger-macro-v1.webp'} srcset={photo+'cheeseburger-macro-v1-768.webp 768w, '+photo+'cheeseburger-macro-v1.webp 1536w'} sizes="(max-width: 700px) 92vw, 43vw" width="1536" height="1024" alt={t(lang,'Creative close-up of cheese, sauce and the layers of an Angus beef burger','安格斯牛肉堡芝士、酱汁与食材层次的创意特写')} loading="lazy" decoding="async"/></div>
        <figcaption>
          <h3>{t(lang,'Every layer.','层层叠叠，')}<br/>{' '}{t(lang,'All flavor.','口口有味。')}</h3>
          <div class="taste-caption"><p>{t(lang,'Cheese, sauce, and a bite worth slowing down for.','芝士与酱汁交融，每一层都值得细细品尝。')}</p></div>
        </figcaption>
      </figure>
      <figure class="taste-handheld" data-food-reveal>
        <div class="taste-photo"><img src={photo+'handheld-burger-v1.webp'} srcset={photo+'handheld-burger-v1-768.webp 768w, '+photo+'handheld-burger-v1.webp 1536w'} sizes="(max-width: 700px) 92vw, 49vw" width="1536" height="1024" alt={t(lang,'Creative image of a cheeseburger held in a paper sleeve against a red backdrop','红色背景前，双手拿着纸套芝士汉堡的创意展示')} loading="lazy" decoding="async"/></div>
        <figcaption>
          <h3>{t(lang,'Good mood.','双手捧起，')}<br/>{' '}{t(lang,'Both hands.','大口满足。')}</h3>
          <div class="taste-caption"><a class="text-link" href={url(lang,'menu')+'#burgers-wraps'}>{t(lang,'Meet the burgers','看看汉堡与卷饼')} <Arrow diagonal/></a></div>
        </figcaption>
      </figure>
    </div>
    <div class="taste-signoff">
      <span class="taste-cheer">{t(lang,"LET’S EAT!",'开吃！')}</span>
    </div>
  </div>
  <svg class="taste-wave taste-wave-bottom" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50C240 -30 360 120 620 65S1020 0 1190 45S1360 80 1440 30V100H0Z" fill="currentColor"/></svg>
</section>
<style>
  .taste-story { padding-bottom: 45px; overflow: clip; }
  .taste-story .taste-lead { display: block; text-align: center; }
  .taste-story .taste-copy p { margin-inline: auto !important; max-width: 38em !important; }
  :global(.page-home #main) .taste-copy > .text-link { display: inline-flex; justify-content: center; padding: 20px 42px; border: 3px solid #fffdf8; border-radius: 50%; background: #ed291c; color: #fffdf8; text-decoration: none; }
  .taste-gallery { position: relative; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 30px; max-width: 1190px; margin: 100px auto 0; padding: 0 35px; }
  .taste-gallery > figure { display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 0; margin: 0; min-width: 0; aspect-ratio: auto; rotate: none; }
  .taste-gallery .taste-photo { aspect-ratio: 4 / 5; border-radius: 18px; }
  .taste-gallery .taste-chicken .taste-photo { rotate: 3deg; }
  .taste-gallery .taste-detail .taste-photo { rotate: -5deg; }
  .taste-gallery .taste-handheld .taste-photo { rotate: 7deg; }
  .taste-gallery .taste-photo img { height: 100%; object-fit: cover; }
  .taste-gallery figcaption { position: static; background: none; color: inherit; border-radius: 0; padding: 38px 0 0; text-align: center; }
  .taste-gallery figcaption h3 { font-size: clamp(26px,2.5vw,38px); line-height: 1.15; }
  .taste-gallery figcaption { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; }
  .taste-caption { align-self: start; display: grid; justify-items: center; }
  .taste-caption[data-motion="entering"] { overflow: clip; }
  .taste-sticker { position: absolute; z-index: 2; width: clamp(115px,16vw,215px); height: auto; top: -120px; left: -75px; rotate: -18deg; pointer-events: none; filter: drop-shadow(0 5px 3px #43231130); }
  .taste-story .taste-signoff { padding-top: 30px; align-items: center; gap: 24px; }
  .taste-cheer { font: 400 32px/1 'Mouse Memoirs',sans-serif; color: #ed291c; }
  @media(max-width:700px) {
    .taste-gallery { gap: 12px; margin-top: 70px; padding: 0 10px; }
    .taste-gallery .taste-photo { border-radius: 10px; }
    .taste-sticker { width: 90px; left: -12px; top: -63px; }
    .taste-gallery figcaption { padding-top: 24px; }
    .taste-gallery figcaption h3 { font-size: 22px; }
    .taste-story .taste-signoff { flex-wrap: wrap; }
  }
</style>
<script>
  const preference=matchMedia('(prefers-reduced-motion: reduce)');
  const animations=new Set<Animation>();
  let observer:IntersectionObserver|undefined;
  function initializeFoodReveal(){
    observer?.disconnect();
    for(const animation of animations)animation.cancel();
    animations.clear();
    if(preference.matches||!('IntersectionObserver'in window)||!Element.prototype.animate)return;
    observer=new IntersectionObserver(entries=>{
      for(const entry of entries){
        if(!entry.isIntersecting)continue;
        observer?.unobserve(entry.target);
        const target=entry.target as HTMLElement;
        if(target.dataset.foodRevealed)return;
        target.dataset.foodRevealed='true';
        const photo=target.matches('.taste-photo')?target:target.querySelector('.taste-photo');
        if(!photo)continue;
        const compact=matchMedia('(max-width: 700px)').matches;
        const animation=photo.animate(compact
          ?[{transform:'translateY(12px)'},{transform:'translateY(0)'}]
          :[{clipPath:'inset(5% 3% round 12px)'},{clipPath:'inset(0% 0% round 12px)'}],
          {duration:compact?450:850,easing:'cubic-bezier(.16,1,.3,1)'});
        animations.add(animation);
        animation.finished.then(()=>animations.delete(animation),()=>animations.delete(animation));
      }
    },{threshold:.15});
    document.querySelectorAll('[data-food-reveal]').forEach(el=>observer?.observe(el));
  }
  initializeFoodReveal();
  preference.addEventListener('change',initializeFoodReveal);
  window.addEventListener('pagehide',()=>{observer?.disconnect();for(const a of animations)a.cancel();});
</script>
