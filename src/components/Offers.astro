---
import OfferCards from './OfferCards.astro';
import OfferBenefits from './OfferBenefits.astro';
import {locale,t,url,type Language,type PageKind} from '../lib/site';
const {lang,kind}=Astro.props as {lang:Language,kind:PageKind};
const offer=locale(lang).offers.find((o:any)=>o.id===kind);
const isStaff=kind==='staff-offer';
---
{kind==='offers'?<>
  <section class="page-intro wrap"><span class="eyebrow">FRYDOM EXPRESS · {t(lang,'OFFERS','新品与优惠')}</span><h1>{t(lang,'Good food.','好滋味。')}<br/><em>{t(lang,'A little extra joy.','再加点惊喜。')}</em></h1><div class="intro-bottom"><p>{t(lang,'Discover a new crispy favorite, bring the team together, or share a bucket with a blind box surprise. Explore each offer for details and participating locations.','尝一口新品，和同事一起享福利，或来一桶炸鸡收获盲盒惊喜。查看各项活动的内容、规则与门店信息。')}</p></div></section>
  <OfferCards lang={lang}/>
</>:<>
  <section class="campaign-detail wrap section-pad">
    <div class="campaign-copy"><span class="eyebrow">{offer.scope}</span><h1>{offer.title}</h1><p class="campaign-price">{offer.headline}</p><p class="lead">{offer.description}</p>
      <h2>{t(lang,'What’s included','活动内容')}</h2><div class="campaign-benefits"><OfferBenefits offer={offer} lang={lang}/></div>
      <div class="campaign-terms"><h2>{t(lang,'Before you visit','到店前了解一下')}</h2><p>{isStaff&&t(lang,'Show your work ID to enjoy these benefits. ','出示工作证件 ID 即可享受以上福利。')}{offer.terms}</p></div>
      {isStaff?<div class="campaign-contact"><h2>{t(lang,'Visit us in Brooklyn','到 Brooklyn 门店享优惠')}</h2><address>781 61st St, Brooklyn, NY 11220</address><div class="campaign-actions"><a class="button button-dark" href="tel:+19298050718">{t(lang,'Call for group meals','电话咨询团餐')} ↗</a><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=781%2061st%20St%20Brooklyn%20NY%2011220">{t(lang,'Get directions','导航到店')} ↗</a></div><p>929-805-0718</p></div>:<div class="campaign-actions"><a class="button button-dark" href={url(lang,'locations')}>{t(lang,'Find a location','查看门店')} ↗</a><a class="text-link" href={url(lang,'menu')+'#'+kind}>{t(lang,'View on menu','在菜单中查看')} ↗</a></div>}
      <a class="text-link campaign-back" href={url(lang,'offers')}>← {t(lang,'All offers','全部活动')}</a>
    </div>
    <div class={'campaign-art campaign-art-'+kind}><span class="campaign-art-label">{isStaff?t(lang,'GOOD FOOD. GREAT COMPANY.','好好吃饭 · 一起享福利'):kind==='leg-quarter'?t(lang,'FRESHLY FRIED','现点现炸'):t(lang,'MADE FOR SHARING','美味一起分享')}</span><img src={offer.image.src} width={offer.image.width} height={offer.image.height} alt={offer.title} fetchpriority="high" decoding="async"/></div>
  </section>
</>}
