---
import OfferCards from './OfferCards.astro';
import {locale,t,type Language,type PageKind} from '../lib/site';
const {lang,kind}=Astro.props as {lang:Language,kind:PageKind};
const offer=locale(lang).offers.find((o:any)=>o.id===kind);
const store=locale(lang).locations[0];
const posterPages=kind==='staff-offer'?2:1;
const posterWidth=kind==='staff-offer'?1855:1701;
---
{kind==='offers'?<>
  <section class="page-intro wrap"><span class="eyebrow">FRYDOM EXPRESS · {t(lang,'OFFERS','新品与优惠')}</span><h1><span class="title-highlight">{t(lang,'Good food.','好滋味。')}<br/><em>{t(lang,'A little extra joy.','再加点惊喜。')}</em></span></h1><div class="intro-bottom"><p>{t(lang,'Discover a new crispy favorite, bring the team together, or share a bucket with a blind box surprise. Explore each offer for details and participating locations.','尝一口新品，和同事一起享福利，或来一桶炸鸡收获盲盒惊喜。查看各项活动的内容、规则与门店信息。')}</p></div></section>
  <OfferCards lang={lang}/>
</>:<>
<section class="campaign-copy wrap" aria-labelledby="campaign-title">
  <span class="eyebrow">{offer.scope}</span>
  <h1 id="campaign-title">{offer.title}</h1>
  <p class="campaign-price">{offer.headline}</p><p>{offer.description}</p>
  <div class="campaign-facts"><div><h2>{t(lang,'What’s included','优惠内容')}</h2><ul>{offer.benefits.map((benefit:string)=><li>{benefit}</li>)}</ul></div>
  <div class="campaign-terms"><h2>{t(lang,'Before you order','使用说明')}</h2>
    {kind==='staff-offer'&&<p>{t(lang,'Show your work ID at 781 61st St, Brooklyn, NY 11220.','到店出示工作证件 ID。适用地址：781 61st St, Brooklyn, NY 11220。')}</p>}
    <p>{offer.terms}</p>
    <a class="button button-dark" href={store.phoneHref}>{t(lang,'Call about this offer','致电咨询活动')} ↗</a>
    <a class="campaign-phone" href={store.phoneHref}>{store.phone}</a>
  </div></div>
  <a class="text-link" href="#original-posters">{t(lang,'View original poster','查看原版海报')} ↓</a>
</section>
<section class="campaign-posters" id="original-posters" aria-label={t(lang,'Original promotion posters','活动原版海报')}>
  {Array.from({length:posterPages},(_,index)=><a class="poster-page" href={`/assets/posters/${kind}.pdf#page=${index+1}`} target="_blank" rel="noopener" aria-label={t(lang,`Open ${offer.title} original PDF, page ${index+1}`,`打开${offer.title}原始 PDF，第 ${index+1} 页`)}>
    <img src={`/assets/posters/${kind}-${index+1}.webp`} width={posterWidth} height="2400" alt={t(lang,`${offer.title} — original poster, page ${index+1}`,`${offer.title}原版海报，第 ${index+1} 页`)} loading="lazy" decoding="async"/>
  </a>)}
</section></>}

<style>
  .campaign-posters { width: min(1000px, calc(100% - 40px)); margin: 28px auto 48px; display: grid; gap: 24px; }
  .campaign-posters .poster-title { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .poster-page { display: block; line-height: 0; }
  .poster-page img { display: block; width: 100%; height: auto; }
  @media (max-width: 700px) { .campaign-posters { width: calc(100% - 24px); margin-block: 12px 24px; gap: 16px; } }
</style>
