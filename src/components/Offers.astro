---
import OfferCards from './OfferCards.astro';
import {locale,t,type Language,type PageKind} from '../lib/site';
const {lang,kind}=Astro.props as {lang:Language,kind:PageKind};
const offer=locale(lang).offers.find((o:any)=>o.id===kind);
const store=locale(lang).locations[0];
const posterPages=kind==='staff-offer'?2:1;
const posterWidth=kind==='staff-offer'?1855:1701;
---
{kind==='offers'?<OfferCards lang={lang}/>:<>
<section class="campaign-copy" aria-labelledby="campaign-title">
  <header class="offer-intro wrap">
  <h1 id="campaign-title">{offer.title}</h1>
  <p class="campaign-price">{offer.headline}</p>
  <span class="eyebrow">{offer.scope}</span>
  <p>{offer.description}</p>
  </header>
  <div class="offer-band">
    <svg class="offer-wave-top" viewBox="0 0 1440 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V20C1220 140 1110 0 920 45S650 180 440 100S150 -20 0 45Z" fill="currentColor"/></svg>
    <section class="offer-benefits">
      <h2>{t(lang,'What’s included','优惠内容')}</h2>
      <ul>{offer.benefits.map((benefit:string)=><li>{benefit}</li>)}</ul>
    </section>
    <section class="campaign-terms"><h2>{t(lang,'Before you order','使用说明')}</h2>
    {kind==='staff-offer'&&<p>{t(lang,'Show your work ID at 781 61st St, Brooklyn, NY 11220.','到店出示工作证件 ID。适用地址：781 61st St, Brooklyn, NY 11220。')}</p>}
    <p>{offer.terms}</p>
    <a class="button button-dark" href={store.phoneHref}>{t(lang,'Call about this offer','致电咨询活动')} ↗</a>
    <a class="campaign-phone" href={store.phoneHref}>{store.phone}</a>
    </section>
    <svg class="offer-wave-bottom" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 50C240 -30 360 120 620 65S1020 0 1190 45S1360 80 1440 30V100H0Z" fill="currentColor"/></svg>
  </div>
  <div class="offer-poster-link wrap"><a class="text-link" href="#original-posters">{t(lang,'View original poster','查看原版海报')} ↓</a></div>
</section>
<section class="campaign-posters" id="original-posters" aria-label={t(lang,'Original promotion posters','活动原版海报')}>
  {posterPages > 1 && <div class="poster-controls" hidden>
    <button type="button" data-prev aria-label={t(lang,'Previous poster page','上一页海报')} disabled>←</button>
    <span aria-live="polite" aria-atomic="true">1 / {posterPages}</span>
    <button type="button" data-next aria-label={t(lang,'Next poster page','下一页海报')}>→</button>
  </div>}
  {Array.from({length:posterPages},(_,index)=><a class="poster-page" hidden={index>0} href={`/assets/posters/${kind}.pdf#page=${index+1}`} target="_blank" rel="noopener" aria-label={t(lang,`Open ${offer.title} original PDF, page ${index+1}`,`打开${offer.title}原始 PDF，第 ${index+1} 页`)}>
    <img src={`/assets/posters/${kind}-${index+1}.webp`} width={posterWidth} height="2400" alt={t(lang,`${offer.title} — original poster, page ${index+1}`,`${offer.title}原版海报，第 ${index+1} 页`)} loading="lazy" decoding="async"/>
  </a>)}
</section></>}

<script>
  const controls = document.querySelector<HTMLElement>('.poster-controls');
  if (controls) {
    const pages = controls.parentElement!.querySelectorAll<HTMLAnchorElement>('.poster-page');
    const previous = controls.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-next]')!;
    const counter = controls.querySelector('span')!;
    let current = 0;
    function show(index: number) {
      current = Math.max(0, Math.min(pages.length - 1, index));
      pages.forEach((page, i) => { page.hidden = i !== current; });
      counter.textContent = (current + 1) + ' / ' + pages.length;
      previous.disabled = current === 0;
      next.disabled = current === pages.length - 1;
    }
    previous.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    controls.hidden = false;
  }
</script>

<style>
  .campaign-copy { --body-face: var(--display); max-width: none; padding-bottom: 0; }
  .offer-intro, .offer-poster-link { max-width: 1100px; }
  .offer-intro { margin-bottom: 32px; }
  .offer-poster-link { margin-top: 24px; }
  :global(#main) .campaign-copy h1 {
    margin: 0;
    color: #ed291c;
    font-size: clamp(44px, 7vw, 96px);
    line-height: 1.08;
    -webkit-text-stroke: .09em white;
    paint-order: stroke fill;
  }
  :global(#main) .campaign-copy .campaign-price {
    font-size: clamp(36px, 4.5vw, 64px);
    color: #c82c1b;
    line-height: 1.15;
    margin-block: 12px 26px;
    -webkit-text-stroke-width: 0 !important;
  }
  :global(#main) .campaign-copy :is(p:not(.campaign-price), li) {
    font-size: clamp(22px, 2.3vw, 28px);
    line-height: 1.5;
  }
  .offer-band {
    --outer-gutter: max(30px, calc(50vw - 550px));
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: clip;
  }
  .offer-band > section {
    margin: 0;
    padding-block: 112px 92px;
    border: 0;
    border-radius: 0;
    text-align: start;
  }
  .offer-benefits {
    padding-inline: var(--outer-gutter) clamp(24px, 4vw, 64px);
    background: #ff1b12;
    color: var(--cream);
  }
  .offer-band .campaign-terms {
    padding-inline: clamp(24px, 4vw, 64px) var(--outer-gutter);
    background: #ffda50;
    color: var(--body);
  }
  :global(#main) .offer-band h2 {
    margin: 0 0 20px;
    font-size: 52px;
    line-height: 1.1;
    color: inherit;
    -webkit-text-stroke-width: 0 !important;
  }
  :global(#main) .offer-band :is(p,li) { font-size: 28px; color: inherit; }
  .offer-band ul { margin: 0; padding-inline-start: 1.2em; }
  .offer-band li + li { margin-top: 12px; }
  .offer-band .campaign-phone { color: inherit; -webkit-text-stroke-width: 0 !important; }
  .offer-band > svg {
    position: absolute;
    left: 0;
    width: 100%;
    pointer-events: none;
    color: var(--cream);
  }
  .offer-wave-top { top: -1px; height: 82px; }
  .offer-wave-bottom { bottom: -1px; height: 62px; }
  @media (max-width: 700px) {
    .offer-band { --outer-gutter: 24px; grid-template-columns: 1fr; }
    .offer-band .offer-benefits { padding: 80px var(--outer-gutter) 34px; }
    .offer-band .campaign-terms { padding: 36px var(--outer-gutter) 76px; }
    .offer-wave-top { height: 52px; }
    .offer-wave-bottom { height: 44px; }
    :global(#main) .offer-band h2 { font-size: 36px; }
    :global(#main) .offer-band :is(p,li) { font-size: 22px; }
  }
  .campaign-posters { width: min(1000px, calc(100% - 40px)); margin: 28px auto 48px; display: grid; gap: 24px; }
  .poster-controls { display: flex; align-items: center; justify-content: center; gap: 20px; font: 400 24px/1.3 var(--display); }
  .poster-controls button { width: 48px; height: 48px; border: 0; border-radius: 50%; background: var(--accent-strong); color: var(--cream); font-size: 24px; }
  .poster-controls button:disabled { opacity: .4; cursor: default; }
  .poster-controls[hidden], .poster-page[hidden] { display: none; }
  .poster-page { display: block; line-height: 0; }
  .poster-page img { display: block; width: 100%; height: auto; }
  @media (max-width: 700px) { .campaign-posters { width: calc(100% - 24px); margin-block: 12px 24px; gap: 16px; } }
</style>
